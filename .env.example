APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Keep debug off unless actively troubleshooting; see README (APP_DEBUG section).
APP_DEBUG=false
APP_URL=http://localhost

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SANCTUM_EXPIRATION=1440

LOG_CHANNEL=stack
# warning for production templates; use debug only while troubleshooting
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# For Docker dev: set DB_HOST=postgres (service name)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kominfo_wfh
DB_USERNAME=kominfo
DB_PASSWORD=kominfo

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# --- Khusus aplikasi ini ------------------------------------------------

# Prefix nomor dokumen paket perubahan (config/change-mgmt.php). Nilai kosong
# jatuh ke default 9/1.1/114.
CHANGE_DOC_PREFIX=9/1.1/114

# Kosongkan agar seeder membuat password acak (dicetak sekali). Jangan commit
# password admin ke repository.
APP_ADMIN_PASSWORD=

# Demo accounts (DemoUsersSeeder) hanya dibuat di local/testing. Kosongkan agar
# dibuat acak dan dicetak sekali.
APP_DEMO_PASSWORD=
